{
  "name": "dsh-session-delete",
  "version": "0.3.2",
  "description": "给 DSH 会话行加一个真删除按钮：先让宿主 registry 遗忘（内存 + 磁盘），再删正文/投影缓存，最后广播移除事件。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "DISCLAIMER.md",
    "LICENSE",
    "docs/",
    "assets/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "node --check lib/index.js && node --check lib/client.js",
    "test": "node --test test/smoke.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "delete",
    "sidebar",
    "cordis"
  ],
  "author": "小富富 <QQ 811588817>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xffwlkjgzs88/dsh-session-delete.git"
  },
  "homepage": "https://github.com/xffwlkjgzs88/dsh-session-delete#readme",
  "bugs": {
    "url": "https://github.com/xffwlkjgzs88/dsh-session-delete/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "immediately": false
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "dependencies": {}
}
